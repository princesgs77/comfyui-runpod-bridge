# ==============================================================================
# ComfyUI Remote — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. NEVER COMMIT .env TO GIT!
# ==============================================================================

# Port for Render Web Service (Render automatically provides PORT in production)
PORT=10000

# ------------------------------------------------------------------------------
# 1. RunPod Serverless Credentials (Server-Side Only)
# ------------------------------------------------------------------------------
# Your RunPod API Key from https://www.runpod.io/console/serverless/user/settings
RUNPOD_API_KEY=your_runpod_api_key_here

# Your RunPod Serverless Endpoint ID (e.g., "vllm-xxxxx" or alphanumeric ID)
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# RunPod API Base URL (defaults to https://api.runpod.ai/v2)
RUNPOD_BASE_URL=https://api.runpod.ai/v2

# ------------------------------------------------------------------------------
# 2. Bridge Security & Access Control
# ------------------------------------------------------------------------------
# Secret Bearer token required for frontend clients to communicate with the bridge
APP_ACCESS_TOKEN=your_secure_random_bridge_access_token_here

# ------------------------------------------------------------------------------
# 3. Google Drive Service Account (Worker-Side / Server-Side)
# ------------------------------------------------------------------------------
# Full JSON string of Google Cloud Service Account key (preferred for serverless env)
# GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# OR path to service account JSON file (for local / volume-mounted environments)
GDRIVE_SERVICE_ACCOUNT_FILE=

# Optional Google API key fallback for public/shared files without service account
GDRIVE_API_KEY=

# ------------------------------------------------------------------------------
# 4. Optional Worker Tuning
# ------------------------------------------------------------------------------
# Path to allowlisted model manifest JSON file
MODEL_MANIFEST_PATH=worker/model_manifest.json

# Maximum execution timeout in seconds (default: 1800 = 30 minutes)
JOB_TIMEOUT_SECONDS=1800
